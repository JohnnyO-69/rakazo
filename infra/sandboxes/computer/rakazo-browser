#!/bin/sh
set -eu
RAKAZO_HOME="${HOME:-/home/rakazo}"
# Page-browser tools and desktop launchers share the assigned display profile.
DISPLAY_NUM="${DISPLAY:-:1}"
DISPLAY_NUM="${DISPLAY_NUM#:}"
DISPLAY_NUM="${DISPLAY_NUM%%.*}"
case "$DISPLAY_NUM" in
  ''|*[!0-9]*) DISPLAY_NUM=1 ;;
esac
# POSIX shell arithmetic treats a leading zero as octal.
while [ "${DISPLAY_NUM#0}" != "$DISPLAY_NUM" ]; do DISPLAY_NUM="${DISPLAY_NUM#0}"; done
DISPLAY_NUM="${DISPLAY_NUM:-0}"
DEBUG_PORT=$((9221 + DISPLAY_NUM))
if [ -n "${RAKAZO_BROWSER_PROFILE:-}" ]; then
  PROFILE="$RAKAZO_BROWSER_PROFILE"
elif [ -s "/tmp/rakazo/browser-profile-$DISPLAY_NUM" ]; then
  PROFILE="$(cat "/tmp/rakazo/browser-profile-$DISPLAY_NUM")"
else
  case "$DISPLAY_NUM" in
    1) PROFILE="$RAKAZO_HOME/.browser-profiles/chromium" ;;
    *) PROFILE="$RAKAZO_HOME/.browser-profiles/chromium-screen-$DISPLAY_NUM" ;;
  esac
fi
mkdir -p "$PROFILE"
BIN="$(command -v chromium || command -v chromium-browser || true)"
if [ -z "$BIN" ]; then
  echo "chromium is not installed" >&2
  exit 1
fi
USER_DATA_DIR_SET=0
ACTUAL_PROFILE="$PROFILE"
PREV_ARG_WAS_USER_DATA_DIR=0
for arg in "$@"; do
  if [ "$PREV_ARG_WAS_USER_DATA_DIR" -eq 1 ]; then
    ACTUAL_PROFILE="$arg"
    PREV_ARG_WAS_USER_DATA_DIR=0
  fi
  case "$arg" in
    --user-data-dir=*) ACTUAL_PROFILE="${arg#*=}"; USER_DATA_DIR_SET=1 ;;
    --user-data-dir) PREV_ARG_WAS_USER_DATA_DIR=1; USER_DATA_DIR_SET=1 ;;
  esac
done

clear_crash_state() {
  f="$1"
  [ -f "$f" ] || return 0
  sed -E \
    's/"exit_type"[[:space:]]*:[[:space:]]*"Crashed"/"exit_type":"Normal"/g; s/"exited_cleanly"[[:space:]]*:[[:space:]]*false/"exited_cleanly":true/g' \
    "$f" > "${f}.tmp" && mv "${f}.tmp" "$f"
}

# Match one argument in NUL-separated argv or in Chromium's space-joined title.
# The whole flag is the search string, so spaces and " --" inside a profile path stay intact.
cmdline_text() {
  tr '\0' '\n' <"/proc/$1/cmdline" 2>/dev/null || true
}
has_arg() {
  text=$(cmdline_text "$1")
  if printf '%s\n' "$text" | grep -Fx -- "$2" >/dev/null; then return 0; fi
  if printf ' %s ' "$text" | grep -F -- " $2 " >/dev/null; then return 0; fi
  return 1
}
has_prefix() {
  text=$(cmdline_text "$1")
  if [ $# -ge 3 ]; then
    case "$text" in
      *"$3"*) text="${text%%"$3"*}${text#*"$3"}" ;;
    esac
  fi
  if printf '%s\n' "$text" | grep -e "^$2" >/dev/null; then return 0; fi
  if printf ' %s ' "$text" | grep -F -- " $2" >/dev/null; then return 0; fi
  return 1
}

# A stale SingletonLock is not a live browser. Leaving exit_type=Crashed makes Chrome
# drop session cookies (account sign-in) on the next start while persistent cookies remain.
# kill -0 is not enough: the PID may have been reused by an unrelated process.
profile_lock_pid() {
  profile="$1"
  lock=$(readlink "$profile/SingletonLock" 2>/dev/null || true)
  pid=${lock##*-}
  case "$pid" in
    ''|*[!0-9]*) return 1 ;;
  esac
  printf '%s\n' "$pid"
}

profile_lock_is_live() {
  profile="$1"
  pid=$(profile_lock_pid "$profile") || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  [ -r "/proc/$pid/cmdline" ] || return 0
  has_arg "$pid" "--user-data-dir=$profile" || return 1
  if has_prefix "$pid" "--type=" "--user-data-dir=$profile"; then
    return 1
  fi
  return 0
}

# The lock often points at a wrapper, a renderer, or a reused PID while the
# debugger-owning browser is still running. Rewriting that profile or starting
# another Chromium drops the live session.
profile_browser_pid() {
  profile="$1"
  [ -d /proc ] || return 1
  for proc_dir in /proc/[0-9]*; do
    pid="${proc_dir#/proc/}"
    case "$pid" in
      ''|*[!0-9]*) continue ;;
    esac
    kill -0 "$pid" 2>/dev/null || continue
    has_arg "$pid" "--user-data-dir=$profile" || continue
    has_prefix "$pid" "--remote-debugging-port=" "--user-data-dir=$profile" || continue
    if has_prefix "$pid" "--type=" "--user-data-dir=$profile"; then
      continue
    fi
    printf '%s\n' "$pid"
    return 0
  done
  return 1
}

# Computer control treats a launcher still running after its spawn poll as success.
# 1.6s fits a cold python start and urllib import, then /json/new while the debugger
# comes up. A socket that accepts and never answers fails on the 0.5s request cap.
# The browser spawn poll is longer than this plus the profile scan.
open_live_browser_url() {
  timeout 1.6 python3 -c 'import sys, time, urllib.error, urllib.parse, urllib.request
pid, profile, url = sys.argv[1:]
data = open("/proc/" + pid + "/cmdline", "rb").read().replace(b"\0", b" ")
if profile:
    data = data.replace(b"--user-data-dir=" + profile.encode(), b" ", 1)
key = b"--remote-debugging-port="
start = len(data)
port = None
while True:
    start = data.rfind(key, 0, start)
    if start < 0:
        break
    if start == 0 or data[start - 1:start] == b" ":
        digits = bytearray()
        index = start + len(key)
        while index < len(data) and 48 <= data[index] <= 57:
            digits.append(data[index])
            index += 1
        if digits:
            port = int(digits)
            break
if port is None:
    raise SystemExit(1)
target = "http://127.0.0.1:" + str(port) + "/json/new?" + urllib.parse.quote(url, safe="")
deadline = time.monotonic() + 1.0
while True:
    remaining = deadline - time.monotonic()
    if remaining < 0.05:
        raise SystemExit(1)
    retry = True
    for method in ("PUT", "GET"):
        try:
            req = urllib.request.Request(target, method=method)
            with urllib.request.urlopen(req, timeout=min(0.5, remaining)):
                raise SystemExit(0)
        except SystemExit:
            raise
        except Exception as error:
            reason = error.reason if isinstance(error, urllib.error.URLError) else error
            if isinstance(reason, TimeoutError):
                raise SystemExit(1)
            if not isinstance(reason, OSError):
                retry = False
    if not retry:
        raise SystemExit(1)
    time.sleep(0.05)
' "$@"
}

live_pid=""
lock_pid=""
if [ -d "$ACTUAL_PROFILE" ]; then
  live_pid=$(profile_browser_pid "$ACTUAL_PROFILE" || true)
  lock_pid=$(profile_lock_pid "$ACTUAL_PROFILE" || true)
  if ! profile_lock_is_live "$ACTUAL_PROFILE" && [ -z "$live_pid" ]; then
    rm -f "$ACTUAL_PROFILE/SingletonLock" "$ACTUAL_PROFILE/SingletonCookie" "$ACTUAL_PROFILE/SingletonSocket" 2>/dev/null || true
    find "$ACTUAL_PROFILE" \( -name Preferences -o -name 'Local State' \) -type f 2>/dev/null |
      while IFS= read -r f; do
        clear_crash_state "$f" 2>/dev/null || rm -f "${f}.tmp"
      done || true
  fi
  # Reuse the debugger browser unless the lock names that same process.
  # A live wrapper, renderer, or reused PID must not start another Chromium.
  if [ -n "$live_pid" ] && [ "$lock_pid" != "$live_pid" ]; then
    target_url=""
    for arg in "$@"; do
      case "$arg" in
        --*) ;;
        about:*|*://*) target_url=$arg ;;
      esac
    done
    if [ -n "$target_url" ]; then
      open_live_browser_url "$live_pid" "$ACTUAL_PROFILE" "$target_url" || exit 1
    fi
    exit 0
  fi
fi

FLAGS="--test-type --no-sandbox --disable-dev-shm-usage --disable-gpu --disable-software-rasterizer --no-first-run --no-default-browser-check --disable-session-crashed-bubble --hide-crash-restore-bubble --password-store=basic --restore-last-session --start-maximized --remote-debugging-address=127.0.0.1 --remote-debugging-port=$DEBUG_PORT"
if [ "$USER_DATA_DIR_SET" -eq 0 ]; then
  exec "$BIN" $FLAGS --user-data-dir="$PROFILE" "$@"
fi
exec "$BIN" $FLAGS "$@"
